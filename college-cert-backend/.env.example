# Supabase connection string (get from Supabase project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase S3 Storage credentials (get from Supabase Dashboard > Storage > S3 Configuration)
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# Frontend URL (for CORS) - Update after deploying frontend
FRONTEND_URL=http://localhost:5173

# Backend base URL (for QR codes) - Update after deploying backend
BASE_URL=http://localhost:8000

# Public verification URL template (use {code} placeholder)
VERIFICATION_URL_TEMPLATE=http://localhost:5173/verify/{code}

# Admin secret for authentication - Use strong password in production!
ADMIN_SECRET=your-strong-admin-password-here

# Email configuration for sending certificate links
# Get Gmail App Password from: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Production Example:
# SUPABASE_URL=https://ggtvryukpfwhifftfhaq.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# FRONTEND_URL=https://college-cert.vercel.app
# BASE_URL=https://college-cert-api.onrender.com
# VERIFICATION_URL_TEMPLATE=https://college-cert.vercel.app/verify/{code}
# ADMIN_SECRET=MyStr0ng!Prod!P@ssw0rd123
# SMTP_EMAIL=mihiramin2004@gmail.com
