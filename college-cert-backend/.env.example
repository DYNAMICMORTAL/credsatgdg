# Supabase connection string (get from Supabase project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# If using direct Postgres connection (optional, for advanced usage only):
# SUPABASE_DB_URL=postgresql://user:password@db.xxx.supabase.co:5432/postgres

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend base URL (for QR codes)
BASE_URL=http://localhost:8000

# Public verification URL template (use {code} placeholder)
VERIFICATION_URL_TEMPLATE=http://localhost:5173/verify/{code}

# Admin secret for authentication
ADMIN_SECRET=your-strong-admin-password-here
