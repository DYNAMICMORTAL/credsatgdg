{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key",
    "ADMIN_SECRET": "@admin_secret",
    "SMTP_EMAIL": "@smtp_email",
    "SMTP_PASSWORD": "@smtp_password",
    "FRONTEND_URL": "@frontend_url"
  }
}
